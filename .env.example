# Everything is optional — with no keys the app runs fully in demo mode.
# Optional LLM (any OpenAI-compatible API: OpenAI, Groq, Together, OpenRouter, local Ollama /v1 ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional WhatsApp Cloud API (real sending only when BOTH token and phone number id are set)
WHATSAPP_VERIFY_TOKEN=cyberfield-demo-token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
