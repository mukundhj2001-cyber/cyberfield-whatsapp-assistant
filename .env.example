# Everything is optional — with no keys the app runs fully in demo mode.
# Optional LLM (any OpenAI-compatible API: OpenAI, Groq, Together, OpenRouter, local Ollama /v1 ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional WhatsApp Cloud API (real sending only when BOTH token and phone number id are set)
WHATSAPP_VERIFY_TOKEN=cyberfield-demo-token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to Meta App settings > Basic > App secret to verify X-Hub-Signature-256 on every webhook POST (skipped with a warning if blank)
WHATSAPP_APP_SECRET=
# Optional: Graph API version (default v20.0), send retries (default 3) and first retry delay in seconds (default 0.5)
WHATSAPP_GRAPH_VERSION=
WHATSAPP_SEND_RETRIES=
WHATSAPP_RETRY_BASE_DELAY=

# Dashboard login. If blank, the demo login admin / cyberfield is used and a warning is logged.
# ADMIN_PASSWORD can be plain text or a hash from: cd backend && python -m app.auth "your-password"
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string for signing session cookies (auto-generated and stored in the DB if blank)
SESSION_SECRET=
# true when served over HTTPS (set automatically when the request is https)
COOKIE_SECURE=

# Storage and logging
DB_PATH=
LOG_FORMAT=
LOG_LEVEL=

# Optional vision model for customer photos (defaults to LLM_MODEL; must accept images, e.g. gpt-4o-mini)
LLM_VISION_MODEL=
# Optional speech-to-text for voice notes, any OpenAI-compatible /audio/transcriptions endpoint.
# Falls back to LLM_API_KEY / LLM_BASE_URL. Groq example: STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
